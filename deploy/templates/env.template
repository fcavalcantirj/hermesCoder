# box.env — parameters for box-bootstrap.sh. Copy to /root/box.env, chmod 600,
# fill every REQUIRED value, then run box-bootstrap.sh as root.
# NEVER commit a filled copy of this file.

# ── identity (REQUIRED) ──────────────────────────────────────────────
BOX_USER=agentbot                 # unix user that owns the whole stack
BOX_NAME=my-hermes-box            # hostname-ish label, used in SOUL
BOX_DESC="Hetzner cax21, Debian"  # one-line hardware description for SOUL
AGENT_NAME=MyCoder                # the agent's name (SOUL + introductions)
BOT_HANDLE=MyCoderBot             # telegram bot handle WITHOUT @
OWNER_NAME=Owner                  # human owner's name
OWNER_ID=000000000                # owner's telegram user id
TZ=America/Sao_Paulo

# ── secrets (REQUIRED unless marked optional) ────────────────────────
TELEGRAM_BOT_TOKEN=               # from @BotFather
TELEGRAM_ALLOWED_USERS=           # comma-separated telegram ids allowed to chat
TELEGRAM_HOME_CHANNEL=            # chat id for proactive sends (usually OWNER_ID)
TELEGRAM_HOME_CHANNEL_NAME="Owner DM"
CLAUDE_CODE_OAUTH_TOKEN=          # Claude subscription OAuth (claude setup-token)
JINA_API_KEY=                     # STRONGLY RECOMMENDED — semantic-recall quality lane (jina-embeddings-v4, 2048-dim). Empty = local-only bge-small: works, but noticeably weaker recall

# ── source ───────────────────────────────────────────────────────────
# Toolkit + skills + zvec install from THIS repo checkout. The engine is upstream
# hermes-agent at a pinned release, installed by upstream's own installer; the
# model lane is the official catalog plugin + the Claude Code CLI. Override only
# on purpose (defaults in box-bootstrap.sh):
# ENGINE_REPO=https://github.com/NousResearch/hermes-agent
# ENGINE_REF=v0.21.6                                        # label (release tag)
# ENGINE_COMMIT=818c13be1dc4fd28987e1e881a9408224afd4535   # the commit that tag points at
# PLUGIN_NAME=claude-subscription-directsdk                 # plugin-catalog entry (sha pinned by the catalog)
# CLAUDE_CODE_VERSION=latest                                # npm dist-tag or exact version
# DELEGATE_SDK_VERSION=0.2.165                             # claude-agent-sdk pin for the coding delegate venv
# DELEGATE_VENV_EXTRAS=pytest pytest-cov ruff                 # test tooling for the guard's Python lane
# CLAUDE_CODE_MIN=2.1.293                                   # floor enforced by the bootstrap
# SKIP_GO_TOOLS=0                                           # 1 = skip the slow best-effort go tool installs
GO_VERSION=1.23.4
